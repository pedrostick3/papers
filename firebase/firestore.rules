rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Um documento por jogador, identificado pelo email da conta Google (em minúsculas).
    // Cada jogador só lê e escreve o seu próprio documento.
    function isOwner(email) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
    }
    match /players/{email} {
      allow read, delete: if isOwner(email);
      allow create, update: if isOwner(email)
        && request.resource.data.keys().hasOnly(['profile', 'email', 'uid', 'name', 'updatedAt'])
        && request.resource.data.email == email
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.profile is map
        && request.resource.data.profile.awarded is list
        && request.resource.data.profile.awarded.size() <= 5000
        && request.resource.data.profile.bonus is number
        && request.resource.data.profile.owned is map
        && request.resource.data.profile.eq is map;
    }
    // Tudo o resto fica fechado.
    match /{document=**} { allow read, write: if false; }
  }
}
